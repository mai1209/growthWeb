{
  "expo": {
    "name": "Growth Manager",
    "slug": "growth-manager",
    "version": "1.0.11",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.growthmanager.mobile",
      "buildNumber": "21",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone",
        "NSFaceIDUsageDescription": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
      }
    },
    "android": {
      "package": "app.growthmanager.mobile",
      "versionCode": 21,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#000000",
          "imageWidth": 220
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Growth usa tus fotos para insertar imágenes y analizar comidas.",
          "cameraPermission": "Growth usa la cámara para sacar fotos de tus comidas y estimar calorías."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Growth usa el sensor de movimiento para contar tus pasos del día."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Growth usa tu ubicación para medir la distancia de tus caminatas.",
          "locationAlwaysAndWhenInUsePermission": "Growth usa tu ubicación para seguir midiendo tu caminata aunque la app esté en segundo plano.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ]
  }
}
