{
  "expo": {
    "name": "Growth Manager",
    "slug": "growth-manager",
    "version": "1.0.11",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.growthmanager.mobile",
      "buildNumber": "13",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.growthmanager.mobile",
      "versionCode": 21,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#000000",
          "imageWidth": 220
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Growth usa tus fotos para insertar imágenes en tus notas."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Growth usa el sensor de movimiento para contar tus pasos del día."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Growth usa tu ubicación para medir la distancia de tus caminatas."
        }
      ]
    ]
  }
}
